// -*- mode: jsonc -*-
{
    "layer": "top", // Waybar at top layer
    "position": "top", // Waybar position (top|bottom|left|right)
    "spacing": 0, // Gaps between modules
    "reload_style_on_change": true,
    "modules-left": [
        "network",
        "mango/workspaces",
        "mango/layout",
        "mpd"

    ],
    "modules-center": [
        "mango/window"
    ],
    "modules-right": [
        "tray",
        "custom/pacman",
        "memory",
        "cpu",
        "temperature",
        "backlight",
        "pulseaudio",
        "battery",
        "battery#bat2",
        "custom/notification",
        "clock"
    ],
    "mango/layout": {
        "format": "{}",
        "format-T": "[]=",
        "format-S": "[][",
        "format-M": "[O]",
        "format-G": ":::",
        "format-K": "[]-",
        "format-CT": "|[]|",
        "format-RT": "=[]",
        "format-VT": "TTT",
        "format-VS": "===",
        "format-VG": "[#]",
        "format-VK": "‾T‾",
        "format-DW": "[]+",
        "format-F": "[F]",
        "format-VF": "[VF]"
    },
    "mango/window": {
        "format": "{title}",
        "max-length": 34
    },
    "mango/workspaces": {
        "format": "{icon}",
        "hide-empty": true,
        "on-click": "activate",
        "on-click-right": "toggle",
        "sort-by-id": true,
        "overview-label": "OVERVIEW",
        "format-icons": {
             "1": " ",
             "2": " ",
             "3": " ",
        }
    },
    "custom/pacman": {
        "format": " {}",
        "interval": 1800,                     // every half-hour
        "exec": "checkupdates | wc -l",       // # of updates
        "exec-if": "test $(checkupdates | wc -l) -gt 0",
        "on-click": "pkill -RTMIN+8 waybar && ~/.scripts/update_manager",
        "on-click-right": "pkill -RTMIN+8 waybar",
        "signal": 8
    },
    "mpd": {
        "max-length": 45,
        "format": "{stateIcon}{randomIcon}{repeatIcon}{singleIcon}{artist} - \"{title}\" ",
        "format-disconnected": "Disconnected ",
        "format-stopped": "",
        "unknown-tag": "???",
        "interval": 1,
        "consume-icons": {
            "on": " "
        },
        "random-icons": {
            "on": " "
        },
        "repeat-icons": {
            "on": "󰑖 "
        },
        "single-icons": {
            "on": "󰑘 "
        },
        "state-icons": {
            "paused": " ",
            "playing": " "
        },
        "tooltip-format": "MPD (connected)\n[ {elapsedTime:%M:%S} / {totalTime:%M:%S} ]\nPlaying: \"{title}\"\nby {artist} in \"{album}\"",
        "tooltip-format-disconnected": "MPD (disconnected)",
        "on-click": "mpc toggle"
    },
    "tray": {
        "icon-size": 17,
        "spacing": 5
    },
    "clock": {
        "format": "{:%a %d %b %R}",
        // "format-alt": "{:%d/%m/%Y}",
        "tooltip-format": "<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode"          : "year",
            "mode-mon-col"  : 3,
            "weeks-pos"     : "right",
            "on-scroll"     : 1,
            "format": {
                "months": "<span color='#ffffff'><b>{}</b></span>",
                "days": "<b>{}</b>",
                "weeks": "<span color='#ffffff'><b>W{}</b></span>",
                "weekdays": "<b>{}</b>",
                "today": "<span color='#ffffff'><b><u>{}</u></b></span>"
            },
            "actions": {
                "on-click-right": "mode",
                "on-scroll-up": "tz_up",
                "on-scroll-down": "tz_down",
                "on-scroll-up": "shift_up",
                "on-scroll-down": "shift_down"
            }
        }
    },
    "cpu": {
        "format": " {usage}%",
        "tooltip": true
    },
    "memory": {
        "format": " {}%",
        "tooltip": true
    },
    "temperature": {
        "critical-threshold": 80,
        "format": "{icon}{temperatureC}°C",
        "format-icons": ["", "", ""]
    },
    "backlight": {
        // "device": "acpi_video1",
        "format": "{icon} {percent}%",
        "format-icons": ["", "", "", "", "", "", "", "", ""]
    },
    "battery": {
        "bat": "BAT0",
        "states": {
            // "good": 95,
        },
        "format": "{icon} {capacity}%",
        "format-full": "{icon} {capacity}%",
        "format-charging": "󰂄{capacity}%",
        "format-plugged": " {capacity}%",
        // "format-good": "", // An empty format will hide the module
        // "format-full": "",
        "format-icons": ["", "", "", "", ""]
    },
    "battery#bat2": {
        "bat": "BAT2"
    },
    "network": {
        // "interface": "wlp2*", // (Optional) To force the use of this interface
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}/{cidr}",
        "tooltip-format": "connected to {essid}\n{ifname} via {gwaddr}\nIP: {ipaddr}/{cidr}",
        "format-linked": "{ifname} 󰌹 ",
        "format-disconnected": "󰖪 ",
        "on-click": "nmcli device wifi rescan"
    },
    "pulseaudio": {
        // "scroll-step": 1, // %, can be a float
        "format": "{icon}{volume}%",
        "format-bluetooth": "{icon}{volume}%",
        "format-bluetootj-muted": " ",
        "format-muted": " ",
        "format-icons": {
            "headphone": " ",
            "default": ["", " ", " "]
        },
        "on-click": "foot --app-id=com.popup.app -e wiremix"
    },
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "󰂞 ",
            "none": "󰂜 ",
            "dnd-notification": "󰂛 ",
            "dnd-none": "󰪑 "
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "sleep 0.1 && swaync-client -t -sw",
        "on-click-right": "sleep 0.1 && swaync-client -d -sw",
        "escape": true
    },
}
